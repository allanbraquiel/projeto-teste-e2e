{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed",
        "e2e:ui": "playwright test --ui",
        "e2e:local": "PLAYWRIGHT_START_SERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000 playwright test",
        "e2e:local:headed": "PLAYWRIGHT_START_SERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000 playwright test --headed",
        "e2e:report": "playwright show-report",
        "e2e:allure:clean": "rm -rf allure-results allure-report",
        "e2e:allure:generate": "allure generate allure-results --clean -o allure-report",
        "e2e:allure:open": "allure open allure-report",
        "e2e:allure": "npm run e2e:allure:clean && npm run e2e && npm run e2e:allure:generate",
        "e2e:install": "playwright install --with-deps chromium"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "allure-commandline": "^2.38.1",
        "allure-playwright": "^3.6.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
